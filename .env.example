# Base de datos
DATABASE_URL="postgresql://nexoat:nexoat_dev@localhost:5432/nexoat_dev"
POSTGRES_DB=nexoat_dev
POSTGRES_USER=nexoat
POSTGRES_PASSWORD=nexoat_dev
POSTGRES_PORT=5432

# Backend
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Carpeta donde se guardan los .zip de respaldo de la DB
# (default: backend/storage/backups)
BACKUP_DIR=

# Carpeta donde se guardan los PDF del regalo de bienvenida (onboarding)
# (default: backend/storage/ebooks)
EBOOKS_DIR=

# Sembrar los 3 WelcomeEbook de prueba en un entorno de producción (nunca
# hace falta en desarrollo, ahí siempre se siembran). No setear salvo que
# sepas lo que hacés.
SEED_WELCOME_EBOOKS=

# Gotenberg (HTML→PDF) — genera al vuelo los ebooks de regalo cargados en
# Markdown, con dedicatoria (fase 2, ver docs/features/welcome-ebook-gift.md).
# Sin esto, esos ebooks igual se pueden reclamar pero sin generar el PDF
# hasta que se resuelva y se reintente desde el admin.
GOTENBERG_URL=http://localhost:3002

# Frontend
VITE_API_URL=http://localhost:3001/v1
# Base para URLs absolutas de SEO (canonical, og:url, og:image) — en
# producción https://nexoat.com. Ver docs/features/seo.md.
VITE_SITE_URL=http://localhost:3000

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Bootstrap del primer super-admin (usado por prisma/seed.ts)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# OAuth — opcionales; si faltan, esos botones no aparecen en el login admin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Default si se omite: http://localhost:3001/v1/auth/google/callback (sirve para dev).
# En producción hay que setearla explícitamente con el dominio real del backend,
# y debe coincidir con la "Authorized redirect URI" cargada en Google Cloud Console.
GOOGLE_CALLBACK_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Cloudinary — hosting de imágenes de portada de artículos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — proveedor de email transaccional (ver docs/features/email-provider-resend.md)
# Si se omite, MailService loguea en vez de enviar de verdad (no rompe el dev local sin cuenta de Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL="NexoAT <onboarding@resend.dev>"
# Id de la audiencia de Resend donde se sincroniza NewsletterSubscriber (fase 3). Sin esto, la sincronización queda apagada.
RESEND_AUDIENCE_ID=
