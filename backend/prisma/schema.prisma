generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enumeraciones ──────────────────────────────────────────────────────────

enum Level {
  basico
  intermedio
  avanzado
}

// El identificador Prisma no puede llevar guiones (`@map` solo cambia el
// valor guardado en DB, no el valor que ve el Prisma Client en runtime —
// `Audience.cuidadores_familiares` sigue siendo el string
// "cuidadores_familiares" en JS pase lo que pase). La traducción a los
// strings con guion que espera el frontend (frontend/src/types/index.ts)
// vive en articles/audience.util.ts, en el borde de ArticlesModule.
enum Audience {
  cuidadores_familiares
  profesionales
  mixto
}

enum ArticleStatus {
  borrador
  publicado
  archivado
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  USER
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

// ─── Modelos ────────────────────────────────────────────────────────────────

model Category {
  id                 String            @id @default(cuid())
  slug               String            @unique
  name               String
  description        String?
  icon               String?
  coverImage         String?
  coverImagePublicId String? // ID de Cloudinary — necesario para poder borrar esa imagen puntual
  articles           ArticleCategory[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("categories")
}

model Tag {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  articles ArticleTag[]

  @@map("tags")
}

model Article {
  id                 String            @id @default(cuid())
  slug               String            @unique
  title              String
  subtitle           String?
  excerpt            String?
  content            String
  coverImage         String?
  // ID de Cloudinary del asset de coverImage (ej. "nexoat/articles/xyz") —
  // necesario para poder borrarlo del hosting cuando se reemplaza o se
  // quita la portada. No se expone en la lectura pública del artículo.
  coverImagePublicId String?
  level              Level             @default(basico)
  // Array, no un enum singular: un artículo puede estar dirigido a más de
  // una audiencia a la vez (ver frontend/src/data/mockArticles.ts).
  audience           Audience[]
  status             ArticleStatus     @default(borrador)
  publishedAt        DateTime?
  readingTime        Int? // minutos estimados
  // Fuentes citadas por el artículo: [{ title, url, description? }]. Se
  // completa al importar el .md (campo `fuentes`) o a mano en el form admin.
  sources            Json?
  // Metadata cruda del .md de origen (fecha, estado, temas, auditoría, etc.)
  // tal cual la extrae el importador — no se usa para renderizar, queda de
  // referencia/auditoría del artículo importado.
  importMetadata     Json?
  categories         ArticleCategory[]
  tags               ArticleTag[]
  authorId           String?
  author             User?             @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, publishedAt])
  @@map("articles")
}

// Muchos-a-muchos: un artículo puede pertenecer a más de una categoría
// (ej. un artículo de AT en contexto de neurodiversidad cae en ambas).
model ArticleCategory {
  articleId  String
  categoryId String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@map("article_categories")
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified DateTime?
  name          String?
  avatarUrl     String?
  passwordHash  String? // null si es cuenta 100% OAuth
  role          Role           @default(USER)
  isActive      Boolean        @default(true)
  accounts      OAuthAccount[]
  refreshTokens RefreshToken[]
  articles      Article[]      @relation("ArticleAuthor")
  auditLogs     AuditLog[]     @relation("AuditActor")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model OAuthAccount {
  id             String       @id @default(cuid())
  provider       AuthProvider
  providerUserId String
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String // ej: "article.publish", "user.role_change"
  entityType String? // ej: "Article", "User"
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isActive       Boolean   @default(true)
  source         String? // ej: "homepage-hero", "footer"
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}
