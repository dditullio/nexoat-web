generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enumeraciones ──────────────────────────────────────────────────────────

enum Level {
  basico
  intermedio
  avanzado
}

// El identificador Prisma no puede llevar guiones (`@map` solo cambia el
// valor guardado en DB, no el valor que ve el Prisma Client en runtime —
// `Audience.cuidadores_familiares` sigue siendo el string
// "cuidadores_familiares" en JS pase lo que pase). La traducción a los
// strings con guion que espera el frontend (frontend/src/types/index.ts)
// vive en articles/audience.util.ts, en el borde de ArticlesModule.
enum Audience {
  cuidadores_familiares
  profesionales
  mixto
}

// Eje temático del artículo — a qué gran público pertenece (distinto de
// Audience, que es a quién le habla dentro de ese público). Array porque un
// artículo puede solapar acompanamiento_terapeutico y cuidado_de_mayores; los
// de recursos_profesionales_at en la práctica no solapan con los otros dos.
// Ver docs/features/content-tracks.md. Igual salvedad de guiones que
// Audience: la traducción a los strings con guion del frontend vive en
// articles/track.util.ts.
enum ContentTrack {
  acompanamiento_terapeutico
  cuidado_de_mayores
  recursos_profesionales_at
}

enum ArticleStatus {
  borrador
  publicado
  archivado
}

// Clasificación editorial de acceso ("alcance" en la metadata del .md
// importado) — no confundir con Role (permisos de administración). Por
// ahora es solo clasificación/filtro: el recorte de contenido real para
// suscriptores_nivel_1/2/3 se implementa en una etapa futura, junto con el
// login público de lectores y el sistema de pagos (ver
// docs/features/article-scope-filters.md).
enum ArticleScope {
  publico
  suscriptores_nivel_1
  suscriptores_nivel_2
  suscriptores_nivel_3
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  USER
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

// Nivel de suscripción de un lector — no confundir con Role (permisos de
// administración). Toda cuenta nueva (registro por email u OAuth) nace en
// "gratuito", que ya da acceso a suscriptores_nivel_1. nivel_2/nivel_3 no
// tienen forma de asignarse todavía (no hay cobro real, ver
// docs/features/reader-accounts-and-paywall.md) — el campo existe para que
// la comparación de niveles ya esté escrita cuando llegue esa fase.
enum SubscriptionTier {
  gratuito
  nivel_2
  nivel_3
}

// Quién es el lector dentro del público del sitio — no confundir con Role
// (permisos de administración) ni con SubscriptionTier (nivel de pago).
// Opcional: toda cuenta nace sin elegir (ver docs/features/reader-profile.md),
// se completa desde "Mi perfil". `acompanante_terapeutico` cubre tanto AT en
// ejercicio como estudiantes — separarlos no aporta nada hoy, ambos acceden
// al mismo ProfessionalProfile.
enum ProfileRole {
  acompanante_terapeutico
  cuidador
  familiar
  otro
}

// Estado de moderación de un comentario — ver docs/features/article-comments.md.
enum CommentStatus {
  visible
  oculto // moderado por un editor
  eliminado // borrado por su autor o por un moderador (borrado blando)
}

// ─── Modelos ────────────────────────────────────────────────────────────────

model Category {
  id                 String            @id @default(cuid())
  slug               String            @unique
  name               String
  description        String?
  icon               String?
  coverImage         String?
  coverImagePublicId String? // ID de Cloudinary — necesario para poder borrar esa imagen puntual
  articles           ArticleCategory[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("categories")
}

model Tag {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  articles ArticleTag[]

  @@map("tags")
}

model Article {
  id                 String                @id @default(cuid())
  slug               String                @unique
  title              String
  subtitle           String?
  excerpt            String?
  content            String
  coverImage         String?
  // ID de Cloudinary del asset de coverImage (ej. "nexoat/articles/xyz") —
  // necesario para poder borrarlo del hosting cuando se reemplaza o se
  // quita la portada. No se expone en la lectura pública del artículo.
  coverImagePublicId String?
  level              Level                 @default(basico)
  // Array, no un enum singular: un artículo puede estar dirigido a más de
  // una audiencia a la vez (ver frontend/src/data/mockArticles.ts).
  audience           Audience[]
  tracks             ContentTrack[]        @default([])
  status             ArticleStatus         @default(borrador)
  scope              ArticleScope          @default(publico)
  publishedAt        DateTime?
  readingTime        Int? // minutos estimados
  // Fuentes citadas por el artículo: [{ title, url, description? }]. Se
  // completa al importar el .md (campo `fuentes`) o a mano en el form admin.
  sources            Json?
  // Metadata cruda del .md de origen (fecha, estado, temas, auditoría, etc.)
  // tal cual la extrae el importador — no se usa para renderizar, queda de
  // referencia/auditoría del artículo importado.
  importMetadata     Json?
  categories         ArticleCategory[]
  tags               ArticleTag[]
  authorId           String?
  author             User?                 @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  // Ver docs/features/reader-history-and-saved-articles.md. Relaciones
  // nombradas: hay dos FK distintas de User hacia Article, Prisma exige
  // desambiguar con @relation("...") en ambos lados.
  readBy             ReadingHistoryEntry[] @relation("ReadingHistory")
  savedBy            SavedArticle[]        @relation("SavedArticles")
  // Ver docs/features/article-comments.md. Apagar comentarios en un
  // artículo puntual sin desactivar el sistema entero (checkbox en el form
  // admin) — los comentarios existentes se siguen leyendo igual.
  commentsEnabled    Boolean               @default(true)
  comments           Comment[]             @relation("ArticleComments")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([status, publishedAt])
  @@map("articles")
}

// Muchos-a-muchos: un artículo puede pertenecer a más de una categoría
// (ej. un artículo de AT en contexto de neurodiversidad cae en ambas).
model ArticleCategory {
  articleId  String
  categoryId String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@map("article_categories")
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  emailVerified         DateTime?
  name                  String?
  avatarUrl             String?
  // ID de Cloudinary del avatar (carpeta "avatars") — mismo rol que
  // Article.coverImagePublicId: permite borrar el asset viejo al
  // reemplazar/quitar la foto. Null en avatares que vienen de OAuth (esos
  // son una URL externa de Google/Facebook, no un asset propio).
  avatarPublicId        String?
  // null = cuenta pendiente de activación (alta por email todavía sin
  // confirmar) o 100% OAuth. Mismo guard de validateLocalUser cubre los
  // dos casos: sin passwordHash, no se puede loguear con contraseña.
  passwordHash          String?
  role                  Role                  @default(USER)
  subscriptionTier      SubscriptionTier      @default(gratuito)
  profileRole           ProfileRole?
  professionalProfile   ProfessionalProfile?
  // null = nunca aceptó (cuentas de antes de este campo, a propósito no se
  // simula que sí) — ver docs/features/email-first-signup-and-onboarding.md.
  termsAcceptedAt       DateTime?
  // null = todavía tiene que pasar por /bienvenida. Campo propio, no
  // derivado de profileRole (que se puede volver a "sin elegir" desde
  // /mi-cuenta/perfil sin que eso deba reabrir el onboarding).
  onboardingCompletedAt DateTime?
  isActive              Boolean               @default(true)
  accounts              OAuthAccount[]
  refreshTokens         RefreshToken[]
  articles              Article[]             @relation("ArticleAuthor")
  auditLogs             AuditLog[]            @relation("AuditActor")
  readingHistory        ReadingHistoryEntry[]
  savedArticles         SavedArticle[]
  verificationTokens    VerificationToken[]
  ebookClaim            EbookClaim?
  comments              Comment[]             @relation("CommentAuthor")
  commentLikes          CommentLike[]
  commentReports        CommentReport[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@map("users")
}

// Mini-currículum opcional, solo para profileRole "acompanante_terapeutico"
// o "cuidador" (validado en profile.service.ts, no acá). Ver
// docs/features/reader-profile.md.
model ProfessionalProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization  String
  experienceYears Int?
  bio             String?
  // Reservado para el futuro directorio de acompañantes — sin efecto hoy,
  // no se expone en ningún endpoint público (ver docs/features/reader-profile.md).
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("professional_profiles")
}

enum VerificationTokenType {
  email_verification
  password_reset
  // Confirma que el email existe antes de dejar completar el registro por
  // email/contraseña — ver docs/features/email-first-signup-and-onboarding.md.
  account_activation
}

// Token de un solo uso con expiración, mandado por email — un mismo modelo
// para verificación de cuenta y reset de contraseña (distinto vencimiento
// por `type`, ver docs/features/email-verification-and-password-reset.md).
// Nunca se guarda el token crudo, solo su hash (mismo criterio que
// RefreshToken).
model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, type])
  @@map("verification_tokens")
}

// Un ítem por artículo (no un log de cada visita) — se hace upsert en cada
// lectura, actualizando `readAt`. Ver docs/features/reader-history-and-saved-articles.md.
model ReadingHistoryEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation("ReadingHistory", fields: [articleId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([userId, articleId])
  @@index([userId, readAt])
  @@map("reading_history_entries")
}

// Toggle explícito del lector (distinto del historial, que se registra
// solo). Ver docs/features/reader-history-and-saved-articles.md.
model SavedArticle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation("SavedArticles", fields: [articleId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now())

  @@unique([userId, articleId])
  @@index([userId, savedAt])
  @@map("saved_articles")
}

model OAuthAccount {
  id             String       @id @default(cuid())
  provider       AuthProvider
  providerUserId String
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String // ej: "article.publish", "user.role_change"
  entityType String? // ej: "Article", "User"
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model NewsletterSubscriber {
  id              String    @id @default(cuid())
  email           String    @unique
  isActive        Boolean   @default(true)
  source          String? // ej: "homepage-hero", "footer"
  subscribedAt    DateTime  @default(now())
  unsubscribedAt  DateTime?
  // Id del contacto en la audiencia de Resend — permite actualizar/dar de
  // baja sin re-buscar por email. Null si Resend no está configurado o si
  // la sincronización falló (nunca bloquea el alta/baja local). Ver
  // docs/features/email-provider-resend.md, fase 3.
  resendContactId String?

  @@map("newsletter_subscribers")
}

// Fila única (id fijo "singleton", forzado por SettingsService — nunca se
// crea una segunda) con configuración global del sitio editable desde
// "Configuración" en el admin. Por ahora solo controla qué niveles de
// ArticleScope se muestran en el sitio público: "publico" no aparece acá
// porque siempre se muestra, no es togglable. Pensado como el lugar donde
// sumar más configuraciones a futuro sin agregar una tabla por setting.
model SiteSettings {
  id                   String         @id @default("singleton")
  visibleArticleScopes ArticleScope[] @default([suscriptores_nivel_1])
  updatedAt            DateTime       @updatedAt

  @@map("site_settings")
}

// Regalo de bienvenida ofrecido al terminar el onboarding — ver
// docs/features/welcome-ebook-gift.md. fileKey null = título cargado pero
// sin PDF todavía; no cuenta como "disponible" para el paso de onboarding
// ni para el ítem del menú de usuario (visibilidad por datos, no por
// entorno).
model WelcomeEbook {
  id                 String       @id @default(cuid())
  title              String
  subtitle           String?
  slug               String       @unique
  topic              String // etiqueta libre corta, ej. "Primeros pasos en AT" — no un enum, para no migrar cada vez que se sume una temática
  // Resumen breve — es lo que lee el usuario en la tarjeta para decidir
  // antes de elegir, no una nota interna de catálogo.
  summary            String
  coverImage         String? // Cloudinary, carpeta "ebook-covers" — mismo mecanismo que coverImage de Category/Article
  coverImagePublicId String?
  fileKey            String? // nombre de archivo dentro de storage/ebooks — PDF subido a mano (fase 1)
  fileName           String? // nombre original, para el header Content-Disposition de la descarga
  // Fase 2 (ver docs/features/welcome-ebook-gift.md): Markdown del libro —
  // si está seteado, manda por sobre fileKey y se genera un PDF personalizado
  // (con dedicatoria) al reclamar, vía Gotenberg. fileKey queda de respaldo
  // si content es null.
  content            String?
  // Link a la ficha de compra en la futura tienda — null = sin página de QR
  // al final del PDF generado (visibilidad por datos, no por flag de código).
  storeUrl           String?
  active             Boolean      @default(true)
  claims             EbookClaim[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("welcome_ebooks")
}

// Un usuario reclama un solo ebook de regalo (@@unique en userId) — es un
// regalo de bienvenida, no un catálogo de descargas. onDelete: Restrict en
// ebook para que no se pueda borrar un título ya reclamado por alguien (el
// admin lo desactiva, no lo elimina, si ya tuvo reclamos).
model EbookClaim {
  id        String       @id @default(cuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebookId   String
  ebook     WelcomeEbook @relation(fields: [ebookId], references: [id], onDelete: Restrict)
  claimedAt DateTime     @default(now())
  // Fase 2: PDF personalizado (con dedicatoria) generado al reclamar, en
  // storage/ebooks/generated/ — null si el ebook usa fileKey en vez de
  // content, o si la generación falló (ver GiftsService.claim()).
  generatedFileKey  String?
  generatedFileName String?

  @@index([ebookId])
  @@map("ebook_claims")
}

// Comentario público de un lector registrado. Ver docs/features/article-comments.md.
// Visualmente el hilo se aplana a dos niveles (raíz + respuestas), pero acá
// se guarda el árbol real (`parentId` a cualquier profundidad) — permite
// profundizar la presentación en el futuro sin migrar datos.
model Comment {
  id        String        @id @default(cuid())
  articleId String
  article   Article       @relation("ArticleComments", fields: [articleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  status    CommentStatus @default(visible)
  // Comentario concreto al que se respondió (a cualquier profundidad).
  parentId  String?
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  // Raíz del hilo, denormalizada (null en los comentarios raíz) — permite
  // traer un hilo completo con un findMany plano por rootId, sin recursión.
  rootId    String?
  // Denormalizado, actualizado en la misma transacción que crea/borra el
  // CommentLike — evita un count por comentario en cada listado.
  likeCount Int             @default(0)
  likes     CommentLike[]
  reports   CommentReport[]
  editedAt  DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([articleId, status, createdAt])
  @@index([rootId, createdAt])
  @@index([authorId, createdAt])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

// Reporte de un lector sobre un comentario ajeno — alimenta el filtro
// "reportados" del panel de moderación (@nexoat-admin/comentarios).
model CommentReport {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([createdAt])
  @@map("comment_reports")
}
